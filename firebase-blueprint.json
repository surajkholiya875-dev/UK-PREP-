    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and controlled role metadata stored at /users/{userId}. Protected by strict owner/admin read and server/rules validation.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "phoneNumber": { "type": "string", "maxLength": 20, "pattern": "^[0-9+\\-\\s]{0,20}$" },
        "district": { "type": "string", "maxLength": 80 },
        "primaryTargetExam": { "type": "string", "maxLength": 120 },
        "targetExam": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "emailVerified": { "type": "boolean" },
        "accountStatus": { "type": "string", "enum": ["active", "disabled", "suspended"] },
        "status": { "type": "string", "enum": ["active", "disabled", "suspended"] },
        "preferredTheme": { "type": "string", "enum": ["light", "dark"] },
        "createdAt": { "type": "string", "format": "date-time" },
